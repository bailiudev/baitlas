{
  "type":"object", "additionalProperties":false,
  "required":["id","title","subtitle","description","period","category","map","sources"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9_-]+$"},
    "title":{"type":"string","minLength":1},"subtitle":{"type":"string"},"description":{"type":"string"},"period":{"type":"string"},
    "category":{"enum":["Read","Hike"]},
    "collections":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["Read","Hike"]}},
    "map":{"type":"object","additionalProperties":false,"required":["basemap","style","bounds","extent"],"properties":{
      "basemap":{"type":"string","pattern":"^assets/maps/"},"style":{"type":"string","pattern":"^assets/maps/"},
      "caption":{"type":"string"},"period":{"type":"string"},"disclaimer":{"type":"string"},
      "attribution":{"type":"object","additionalProperties":false,"required":["title","url"],"properties":{"title":{"type":"string"},"url":{"type":"string","pattern":"^https://"},"note":{"type":"string"}}},
      "labels":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["text","coordinates","kind"],"properties":{"text":{"type":"string","minLength":1},"coordinates":{"$ref":"#/definitions/pair"},"kind":{"enum":["ocean","mountain","river"]}}}},
      "markerAnchors":{"type":"object","additionalProperties":{"$ref":"#/definitions/pair"}},
      "routeNote":{"type":"string"},"regionNote":{"type":"string"},
      "bounds":{"$ref":"#/definitions/bounds"},"extent":{"$ref":"#/definitions/bounds"}
    }},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["title","url"],"additionalProperties":false,"properties":{"title":{"type":"string"},"url":{"type":"string","pattern":"^https://"}}}}
  },
  "definitions":{"pair":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},"bounds":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}}}
}
