{
  "name": "baitlas-build",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "build": "node build-content.js && node build-app.js",
    "build:content": "node build-content.js",
    "build:app": "node build-app.js",
    "build:map": "node build-map.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "serve": "python3 -m http.server 8000 --directory .."
  },
  "engines": {"node": ">=20"},
  "dependencies": {
    "@turf/bbox-clip": "7.2.0",
    "@turf/simplify": "7.2.0",
    "ajv": "8.17.1",
    "leaflet": "1.9.4",
    "marked": "15.0.12",
    "sanitize-html": "2.17.0",
    "shapefile": "0.6.6",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.12"
  }
}
